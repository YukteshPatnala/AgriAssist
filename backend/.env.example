# Copy this file to backend/.env and fill in your values. Never commit backend/.env.

# AI model: "openai" (or any OpenAI-compatible API), "gemini", or "none" (retrieval-only mode)
LLM_PROVIDER=openai
LLM_API_KEY=paste-your-key-here
# Leave LLM_MODEL empty to use the default for the provider (gpt-4o-mini or gemini-2.5-flash)
LLM_MODEL=
# Only used by the openai provider. Change it to use another OpenAI-compatible service.
LLM_BASE_URL=https://api.openai.com/v1

# Retrieval settings
TOP_K=4
# Questions whose best match scores below this are escalated instead of answered.
MIN_CONFIDENCE=0.10
CHUNK_WORDS=120
CHUNK_OVERLAP=20

# Comma-separated list of frontend URLs allowed to call the API. Use * only for local demos.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

MAX_UPLOAD_MB=10
AUTH_SECRET=
DATAGOV_API_KEY=
TOKEN_HOURS=
DB_PATH=
WEATHER_BASE_URL=
